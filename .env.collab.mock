# Table-machine build overrides for no-hardware development (ticket 03). Loaded in addition to
# `.env` / `.env.local` when Vite is run with `--mode collab.mock` (`npm run dev:collab:mock`).
# Mirrors `.env.collab` but forces MockTrackingSource so `dev:collab:mock` never needs
# `server.py`/real table hardware running. All other VITE_* vars (map/backend/geoserver URLs,
# keys) still come from `.env` / `.env.local` — this file only flips the Collab module on and
# selects the mock tracking source.
VITE_COLLAB_MODE="true"
# Explicit switch (ticket 03): "mock" forces MockTrackingSource regardless of whether
# VITE_COLLAB_TRACKING_WS_URL is set. To develop against the real table instead, run
# `npm run dev:collab` (`.env.collab`), which defaults to "real".
VITE_COLLAB_TRACKING_MODE="mock"

# Same feature as in `.env.collab` — kept "false" here (production-like flash behaviour) so quick
# no-hardware testing exercises the same table behaviour real deployments get. Set to "true" if you
# specifically want to test the always-on variant without touching `.env.collab`.
VITE_COLLAB_TABLE_FOOTPRINT_ALWAYS_VISIBLE="false"

# See `.env.collab` for the full explanation. Kept small here on purpose so a flash/hide cycle is
# fast to observe during quick mock-mode iteration.
VITE_COLLAB_TABLE_FOOTPRINT_VISIBLE_SECONDS="5"
