# Base URL for the application
VITE_BASE_URL="/"
# MapTiler API Key (replace with your actual API key)
VITE_MAPTILER_API_KEY="your_maptiler_api_key"
# MapTiler API Map ID (replace with your desired map ID)
VITE_MAPTILER_API_MAP_ID="streets-v2"
# Starting longitude for the map
VITE_MAP_START_LNG="your_default_longitude"
# Starting latitude for the map
VITE_MAP_START_LAT="your_default_latitude"
# Starting zoom level for the map
VITE_MAP_START_ZOOM="your_default_zoom"
# Optional GeoServer fallback used by legacy WMS/WMTS layers.
# Catalog workspaces and layer details come from VITE_BACKEND_ROOT_URL.
VITE_GEOSERVER_ROOT_URL="http://your-geoserver-root-url"
# GeoServer WMS/WMTS base URL (catalog providers override this at runtime)
VITE_GEOSERVER_BASE_URL="$VITE_GEOSERVER_ROOT_URL/geoserver"
# Backend Root URL (local development proxies /api and /media to this URL)
VITE_BACKEND_ROOT_URL="http://your-backend-root-url"
# GeoNode REST URL (constructed using the backend root URL)
VITE_GEONODE_REST_URL="$VITE_BACKEND_ROOT_URL/api"
# Enables the Collab (tangible table) module for the local table build.
# Unset/false in normal deploys; set true only in the .env.collab build used on the table machine.
VITE_COLLAB_MODE="false"
# ws://<table-host>:8053 for RealTrackingSource (server.py --client web, ticket 09).
# Unset = Collab falls back to MockTrackingSource (no physical table connected).
VITE_COLLAB_TRACKING_WS_URL=""
# Measured projection-inset border, in centimetres, kept clear at each table edge (ticket 10, B6).
# Set from real edge-accuracy/seam-continuity testing on the physical table — never guessed.
# Unset/invalid = 0 (no border), the neutral placeholder used before that measurement exists.
VITE_COLLAB_PROJECTION_INSET_CM=""
# Target AOI ground scale (real-world metres per table metre) the AOI viewfinder requires before
# accepting a selection — B6: not a fixed decision, set once M3 physical-table testing picks one.
# Unset/invalid = 500, a provisional order-of-magnitude default, not a scale decision.
VITE_COLLAB_TARGET_GROUND_SCALE=""
