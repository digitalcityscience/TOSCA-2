# Base URL for the application
VITE_BASE_URL="/"
# Starting longitude for the map
VITE_MAP_START_LNG="your_default_longitude"
# Starting latitude for the map
VITE_MAP_START_LAT="your_default_latitude"
# Starting zoom level for the map
VITE_MAP_START_ZOOM="your_default_zoom"
# Optional GeoServer fallback used by legacy WMS/WMTS layers.
# Catalog workspaces and layer details come from VITE_BACKEND_ROOT_URL.
VITE_GEOSERVER_ROOT_URL="http://your-geoserver-root-url"
# GeoServer WMS/WMTS base URL (catalog providers override this at runtime)
VITE_GEOSERVER_BASE_URL="$VITE_GEOSERVER_ROOT_URL/geoserver"
# Backend Root URL (local development proxies /api and /media to this URL)
VITE_BACKEND_ROOT_URL="http://your-backend-root-url"
# GeoNode REST URL (constructed using the backend root URL)
VITE_GEONODE_REST_URL="$VITE_BACKEND_ROOT_URL/api"
# ============================================================================
# COLLAB (tangible/touch table) module settings
# This section applies only to the "Collab" table feature. If you have no
# table hardware, leave these all blank — each one falls back to a safe default.
# ============================================================================

# Enables or disables the Collab module.
# WHAT TO SET: "true" -> only in the dedicated .env.collab build on the table machine.
#              "false" or blank -> in every normal (tableless) deployment (default behavior).
VITE_COLLAB_MODE="false"

# WebSocket address of the physical table's tracking server.
# WHAT TO SET: "ws://<table-host>:8053" format, when connecting to the real table
#              (matches server.py --client web, ticket 09).
#              If left blank: Collab falls back to mock (fake) tracking data instead
#              of the real table, so leave this blank when no physical table is connected.
VITE_COLLAB_TRACKING_WS_URL=""

# Explicit switch that forces tracking data to be mock or real (ticket 03).
# WHAT TO SET: "mock" -> always use fake tracking data, even if the WS URL above is set.
#              "real" or blank -> use the WS URL above; if that's also blank, still falls
#              back to mock data.
# For no-hardware development, see `npm run dev:collab:mock` / `.env.collab.mock`.
VITE_COLLAB_TRACKING_MODE=""

# How far the projection stays clear of each table edge (a buffer border), in centimetres.
# WHAT TO SET: the value measured from real edge-accuracy/seam-continuity testing on the
#              physical table (ticket 10, B6), in centimetres (e.g. "2"). NEVER guess this value.
#              If left blank/invalid: defaults to 0 (no border) — the placeholder used
#              before that measurement exists.
VITE_COLLAB_PROJECTION_INSET_CM=""

# Target real-world ground scale the AOI (Area of Interest) viewfinder requires: how many
# real-world metres correspond to 1 metre on the table.
# WHAT TO SET: the numeric value decided from M3 physical-table testing (e.g. "500").
#              This is not a guess — it's a decision to be finalized by testing (B6),
#              so leave it blank until that testing happens.
#              If left blank/invalid: defaults to 500 (a provisional, order-of-magnitude value).
VITE_COLLAB_TARGET_GROUND_SCALE=""

# How far each calibration marker sits inward from its AOI/table corner, as a fraction of
# the table's width (same idea as Vanilla's MARKER_INSET_RATIO).
# Why it's needed: an AOI corner is also a physical table corner; a marker centered exactly
# on it would hang half off the table edge. This ratio pulls it back onto the table surface.
# WHAT TO SET: a ratio between 0 and 1 (e.g. "0.05" = 5% of table width; on a 160x80 cm
#              table that's 8 cm in from every edge).
#              Increase it if the projector overhangs the table and markers still land off it.
#              If left blank/invalid: defaults to 0.05 (the value validated on the Vanilla rig).
#              Setting "0" disables this inset entirely.
VITE_COLLAB_CALIBRATION_MARKER_INSET_RATIO=""

# Whether Table's tracked-building footprint layer stays permanently visible, instead of only
# flashing on for a few seconds after each placement change (a building appearing, moving, or
# disappearing). Control is never affected by this — it is the operator's own view, not the
# projection the physical table shows.
# WHAT TO SET: "true" -> footprints stay on the table permanently (useful for development/
#              debugging, see `.env.collab`, and for demos where you want everything visible).
#              "false" or blank -> production behavior: each footprint flashes for
#              VITE_COLLAB_TABLE_FOOTPRINT_VISIBLE_SECONDS below, then hides, keeping the
#              projected table surface uncluttered once a placement has settled.
VITE_COLLAB_TABLE_FOOTPRINT_ALWAYS_VISIBLE=""

# How long, in seconds, Table's tracked-footprint layer stays visible per flash when
# VITE_COLLAB_TABLE_FOOTPRINT_ALWAYS_VISIBLE above is not "true". Ignored entirely when it is.
# WHAT TO SET: any positive number of seconds (e.g. "5"). Shorten it for a snappier table, or
#              lengthen it if operators need longer to read a placement before it fades.
#              If left blank/invalid: defaults to 5 seconds.
VITE_COLLAB_TABLE_FOOTPRINT_VISIBLE_SECONDS=""

# Movement threshold, in screen pixels on the projected table surface, that separates the
# operator actually moving a block from the cameras' own noise. Only consulted while
# VITE_COLLAB_TABLE_FOOTPRINT_ALWAYS_VISIBLE is not "true".
# Why it's needed: a block sitting motionless still reports a slightly different coordinate on
# every camera frame, so without a threshold the flash timer is reset forever and the layer
# never hides. Measured in screen pixels deliberately — NOT in real-world metres, which would
# have to be divided through the AOI's ~500:1 ground scale and is what got this wrong before.
# WHAT TO SET: a positive number of pixels (e.g. "4"). Raise it if the layer never hides on
#              your rig (noisier cameras); lower it if small, real nudges fail to bring it back.
#              If left blank/invalid: defaults to 4.
VITE_COLLAB_TABLE_FOOTPRINT_MOVEMENT_THRESHOLD_PX=""
