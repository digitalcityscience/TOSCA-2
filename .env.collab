# Table-machine build overrides. Loaded in addition to `.env` / `.env.local`
# when Vite is run with `--mode collab` (see 02-mode-gating.md).
# All other VITE_* vars (map/backend/geoserver URLs, keys) still come from
# .env / .env.local — this file only flips the Collab module on.
VITE_COLLAB_MODE="true"
# ws://<table-host>:8053 for RealTrackingSource (server.py --client web, ticket 09).
# Same machine as server.py here, hence localhost. Not a secret — just a local
# network address; do not add API keys/tokens to this file (it is committed).
VITE_COLLAB_TRACKING_WS_URL="ws://localhost:8053"


# Keeps Table's tracked-footprint layer permanently on instead of flashing per placement change.
# "true" here because this is the dev-table build: seeing every footprint continuously is more
# useful while developing/debugging than the production flash behaviour.
VITE_COLLAB_TABLE_FOOTPRINT_ALWAYS_VISIBLE="true"

# How many seconds Table's tracked-footprint layer stays visible after a placement change, when
# VITE_COLLAB_TABLE_FOOTPRINT_ALWAYS_VISIBLE above is not "true". Unused while that is "true" (as
# it is in this file), but set here too so both vars for this one feature travel together.
VITE_COLLAB_TABLE_FOOTPRINT_VISIBLE_SECONDS="2"

# Screen-pixel movement threshold separating a real nudge from camera noise (see .env.example).
# Raise if the bbox never hides on this rig; lower if small real moves do not bring it back.
#
# 4, and raising it is a trap worth recording. Measurement on this rig (2026-09-07) showed the
# footprints sitting within ~1px at rest with occasional single-frame spikes to ~8px, so 12 looked
# like the safe pick. It was not: the threshold does not only filter noise, it also filters *slow
# real movement*. A block being nudged gently covers less than 12px in the VISIBLE_SECONDS window,
# so the timer expired and the bbox vanished while the operator was still moving the block. 4 keeps
# slow drags lit. The occasional 8px spike re-flashing the layer for 2s is the cheaper of the two
# faults -- fix that by filtering the spike, never by raising this number.
VITE_COLLAB_TABLE_FOOTPRINT_MOVEMENT_THRESHOLD_PX="4"
