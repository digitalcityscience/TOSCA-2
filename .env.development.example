# Local development: copy this file to .env.development and fill in the values.
#   cp .env.development.example .env.development
# A deployed container gets the same variables as container environment
# variables instead (see "Docker" in the README); no rebuild is needed to
# change them.

# Base URL for the application. The Docker image supports only "/".
VITE_BASE_URL="/"
# Keycloak public SPA configuration. Do not put a client secret, admin
# password, access token, or refresh token in any VITE_* variable: every
# VITE_* value is readable by anyone who opens the app.
# Use your deployment's values (ask the platform team); the realm and client
# must match the backend's KEYCLOAK_ISSUER and ALLOWED_TOKEN_CLIENTS.
# Leave all three unset to run without sign-in.
# Keycloak server root, without /realms/...:
VITE_KEYCLOAK_URL="https://auth.example.com"
# Realm the users sign in to:
VITE_KEYCLOAK_REALM="your-realm"
# Public (no secret) OIDC client for this app:
VITE_KEYCLOAK_CLIENT_ID="your-public-client-id"
# Optional OIDC scopes (default "openid profile email"). Add "organization"
# once the web client offers that scope, so tokens carry the user's org.
# VITE_KEYCLOAK_SCOPE="openid profile email organization"
# That Keycloak client needs: Valid redirect URI <app origin><base>auth-callback.html,
# Web origins = the app origin (token endpoint CORS). GeoServer must allow the
# Authorization header in its CORS settings.
# Features available in this deployment, comma-separated from:
# datastores, events, geostories, urbanStories, geosimulations,
# geosimulation-runs. Leave unset to enable all of them except the opt-in ones,
# urbanStories and geosimulation-runs (starting simulation runs; needs a runner
# and backend GEOSIMULATIONS_RUNS_ENABLED=true), which are off unless listed.
# To try Urban Stories locally, put this line in .env.development.local:
# VITE_ENABLED_FEATURES="datastores,events,geostories,urbanStories"
# VITE_ENABLED_FEATURES="events,geostories"
# Brand name shown in the app header. Defaults to "TOSCA".
# VITE_APP_BRAND_NAME="TOSCA"
# MapTiler API Key (replace with your actual API key)
VITE_MAPTILER_API_KEY="your_maptiler_api_key"
# inHouse basemap provider. Individual style IDs and paths live in mapConfig.ts.
# Point this at a browser-safe backend/reverse-proxy endpoint if upstream
# in-house tiles require authentication. Set both or neither; without them the
# in-house basemaps are left out.
VITE_INHOUSE_MAP_BASE_URL="https://maps.example.com"
VITE_INHOUSE_MAP_API_KEY="your_inhouse_map_api_key"
# Starting longitude for the map
VITE_MAP_START_LNG="your_default_longitude"
# Starting latitude for the map
VITE_MAP_START_LAT="your_default_latitude"
# Starting zoom level for the map
VITE_MAP_START_ZOOM="your_default_zoom"
# Optional GeoServer fallback used by legacy WMS/WMTS layers.
# Catalog workspaces and layer details come from VITE_BACKEND_ROOT_URL.
VITE_GEOSERVER_BASE_URL="http://your-geoserver-root-url/geoserver"
# Backend Root URL (local development proxies /api and /media to this URL)
VITE_BACKEND_ROOT_URL="http://your-backend-root-url"
# GeoNode REST URL (the backend root URL followed by /api)
VITE_GEONODE_REST_URL="http://your-backend-root-url/api"
